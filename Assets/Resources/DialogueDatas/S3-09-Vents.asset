  dialogueDatas:
  - panelIndex: 3
    panelObject: {fileID: 0}
    gridPosition: {x: 0, y: 0}
    dialogueText:
    - Where is he taking her?
  - panelIndex: 2
    panelObject: {fileID: 0}
    gridPosition: {x: 1, y: 0}
    dialogueText:
    - To treatment.
  - panelIndex: 3
    panelObject: {fileID: 0}
