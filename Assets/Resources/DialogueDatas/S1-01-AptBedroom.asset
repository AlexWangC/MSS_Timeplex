  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40b937644ddd405448039b17c78e3dcc, type: 3}
  m_Name: S1-01-AptBedroom
  m_EditorClassIdentifier: 
  dialogueDatas:
  - panelIndex: 1
    panelObject: {fileID: 0}
    gridPosition: {x: 3, y: 3}
    dialogueText:
    - "My old house\u2026I can\u2019t believe my time\u2019s come to an end. "
    - " I can\u2019t live on my own anymore. It\u2019s for the best. "
    - "I need to move, so let\u2019s do that."
  - panelIndex: 1
    panelObject: {fileID: 0}
    gridPosition: {x: 1, y: 1}
    dialogueText:
    - It's important to keep a tidy room, which starts with a tidy bed.
  - panelIndex: 1
    panelObject: {fileID: 0}
    gridPosition: {x: 1, y: 3}
    dialogueText:
    - "All of these clothes\u2026I can't even remember all of them Some of them don't
      feel like mine."
  - panelIndex: 1
    panelObject: {fileID: 0}
    gridPosition: {x: 3, y: 0}
    dialogueText:
    - "My little baby\u2026what would I do without you?"
